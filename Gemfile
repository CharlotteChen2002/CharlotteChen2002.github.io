source 'https://rubygems.org'

# The site is built by .github/workflows/jekyll.yml (not the classic GitHub Pages
# builder), so we depend on Jekyll directly instead of the `github-pages` gem,
# which pins Jekyll 3.10 and does not support Ruby 4.
gem 'jekyll', '~> 4.4'
gem 'kramdown-parser-gfm'
gem 'webrick', '~> 1.9'

group :jekyll_plugins do
  gem 'jekyll-feed'
  gem 'jekyll-gist'
  gem 'jekyll-paginate'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
end
